# Large model checkpoints (mount at runtime)
checkpoint/

# Output data
data/output/

# Python cache
__pycache__/
*.pyc
*.pyo

# Backup files
*.backup
*.bak
*_bak*

# Docker files
# NOTE: docker/ must stay in the build context: docker/Dockerfile COPYs
# docker/requirements.txt and docker/entrypoint.sh. Excluding it breaks the
# documented `docker build -f docker/Dockerfile -t eva:latest .` command.
Dockerfile
# Keep the published recipe available to COPY docker/ and image-internal QA.
!docker/Dockerfile
docker/Dockerfile_bak*
docker/EVA.def
docker/smoke_test.sh
.dockerignore

# Figures are not part of the image (34 MB of build context)
fig/

# IDE / OS
.git/
.gitignore
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Benchmark reference tables are source deliverables and stay in the image.
# Generated artifacts (source, configs and benchmark data remain included)
results/
dist/
build/
*.egg-info/
.pytest_cache/
notebooks/interpretability_analysis/sae_repro_release/outputs/
