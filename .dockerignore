# Large model checkpoints (mount at runtime)
checkpoint/

# Output data
examples/data/output/

# Python cache
__pycache__/
*.pyc
*.pyo

# Backup files
*.backup
*.bak
*_bak*

# Docker files
# NOTE: scripts/docker/ must stay in the build context: scripts/docker/Dockerfile COPYs
# scripts/docker/requirements.txt and scripts/docker/entrypoint.sh. Excluding it breaks the
# documented `docker build -f scripts/docker/Dockerfile -t eva:latest .` command.
Dockerfile
# Keep the published recipe available to COPY scripts/docker/ and image-internal QA.
!scripts/docker/Dockerfile
scripts/docker/Dockerfile_bak*
scripts/docker/EVA.def
scripts/docker/smoke_test.sh
.dockerignore

# Figures are not part of the image (34 MB of build context)
docs/assets/

# IDE / OS
.git/
.gitignore
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Benchmark reference tables are source deliverables and stay in the image.
# Generated artifacts (source, configs and benchmark data remain included)
results/
dist/
build/
*.egg-info/
.pytest_cache/
examples/notebooks/interpretability_analysis/sae_repro_release/outputs/
